{
  "version": 2,
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "slug": "void", "color": "#0a0a0a", "name": "Void" },
        { "slug": "obsidian", "color": "#141414", "name": "Obsidian" },
        { "slug": "graphite", "color": "#1f1f1f", "name": "Graphite" },
        { "slug": "smoke", "color": "#2a2a2a", "name": "Smoke" },
        { "slug": "ash", "color": "#8a8a8a", "name": "Ash" },
        { "slug": "silver", "color": "#c4c4c4", "name": "Silver" },
        { "slug": "mist", "color": "#e8e8e8", "name": "Mist" },
        { "slug": "pearl", "color": "#f5f5f5", "name": "Pearl" },
        { "slug": "white", "color": "#ffffff", "name": "White" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "\"Playfair Display\", Georgia, serif",
          "slug": "display",
          "name": "Display"
        },
        {
          "fontFamily": "\"Outfit\", -apple-system, BlinkMacSystemFont, sans-serif",
          "slug": "body",
          "name": "Body"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "1.25rem", "name": "Large" },
        { "slug": "x-large", "size": "2rem", "name": "Extra Large" },
        { "slug": "xx-large", "size": "3rem", "name": "Huge" }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    },
    "layout": {
      "contentSize": "100%",
      "wideSize": "100%"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--obsidian)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.7"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.15"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.2"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--obsidian)"
        }
      }
    }
  },
  "customTemplates": [
    {
      "name": "page-blank",
      "title": "Blank Canvas",
      "postTypes": ["page"]
    }
  ]
}
